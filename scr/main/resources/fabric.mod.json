{
  "schemaVersion": 1,
  "id": "kelpclient",
  "version": "${version}",
  "name": "Ruined Client",
  "description": "A clean, customizable client: nametags, hitboxes, Armor HUD, zoom, macros and more. Restricted modules are locked on public servers.",
  "authors": ["ocxh"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.greenmod.GreenModClient"]
  },
  "mixins": [
    { "config": "kelpclient.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
